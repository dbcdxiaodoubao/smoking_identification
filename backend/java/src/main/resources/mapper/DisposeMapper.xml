<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.smoking_identification.mapper.DisposeMapper">

    <insert id="insert">
        INSERT INTO dispose
            (user_id,incident_id,create_time)
        VALUES
            (#{userId},#{incidentId},NOW())
    </insert>

    <delete id="deleteByincidentId">
        DELETE FROM dispose AS d
        WHERE d.incident_id = #{incidentId}
    </delete>

    <select id="list" resultType="com.ruoyi.smoking_identification.domain.vo.DisposeListVo">
        SELECT *
        FROM dispose
    </select>
</mapper>